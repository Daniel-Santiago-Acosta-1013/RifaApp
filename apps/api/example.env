# Configuracion de la base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rifaapp
DB_USER=appuser
# En produccion (Lambda) usa DB_SECRET_ARN para leer la password desde AWS Secrets Manager.
# En local desarrollo puedes usar DB_PASSWORD directamente.
DB_SECRET_ARN=
DB_PASSWORD=change-me

CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-User-Id
